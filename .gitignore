# =========================
# LazyTopper .gitignore
# Launch-ready + repo-hygiene
# =========================

# ---- Dependencies / builds ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Env files ----
.env
.env.*
!.env.example

# ---- Caches / tooling ----
.eslintcache
.vite/
.cache/
.turbo/
.parcel-cache/

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini
**/desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp

# ---- Repo hygiene (generated / local-only) ----
# Quarantine output from cleanup scripts (do not commit)
_quarantine/

# Archived exports/backups/share artifacts moved under docs/ (do not commit the bulky artifacts)
docs/_repo_hygiene/archive/

# Optional local patch file
src/lazytopper_patch.diff
