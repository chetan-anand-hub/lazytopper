# =========================
# LazyTopper .gitignore
# Launch-ready + safe tooling
# =========================

# ---- Dependencies / builds ----
node_modules/
dist/
build/
coverage/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Env files ----
.env
.env.*
!.env.example

# ---- TypeScript / tooling ----
*.tsbuildinfo

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini
**/desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/

# ---- LazyTopper generated artifacts (do not commit) ----
_exports/
_backups/
_quarantine/

# ---- One-off cleanup pack artifacts (do not commit) ----
LazyTopper_Phase1_Cleanup_Pack_*/
Phase1_*.ps1
Phase1_*.txt
phase1_*.json
phase1_*.csv
LazyTopper_Repo_Cleanup_Phase1_Report_*.docx
README_PHASE1_IMPLEMENTATION_STEPS.txt

# ---- Optional local patch file ----
src/lazytopper_patch.diff
