{
    "name":  "lazytopper",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "tracker:open":  "npm run tracker:ui \u0026\u0026 start \"\" \".project_memory\\tracker_ui\\index.html\"",
                    "pmem:export-crashpack":  "node tools/pmem/pmem-runner.cjs export-crashpack",
                    "server":  "node server/index.cjs",
                    "blackbox:full":  "npm run blackbox -- --full \u0026\u0026 npm run rules:digest \u0026\u0026 npm run blackbox:stage \u0026\u0026 npm run contextpack",
                    "pmem:mark-critical":  "node tools/pmem/pmem-runner.cjs mark-critical",
                    "contextpack":  "node scripts/contextpack.mjs",
                    "tracker:ui":  "npm run tracker \u0026\u0026 node scripts/trackerUi.mjs",
                    "pmem:end-session":  "node tools/pmem/pmem-runner.cjs end-session",
                    "blackbox:ci":  "npm run blackbox:full \u0026\u0026 npm run build",
                    "predev":  "node scripts/prebuild.cjs",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "check:mojibake":  "node scripts/check-mojibake.cjs",
                    "lint":  "eslint .",
                    "rules:digest":  "node scripts/rulesDigest.mjs",
                    "hooks:enable":  "git config core.hooksPath scripts/githooks",
                    "blackbox:stage":  "node scripts/stageTracker.mjs",
                    "dev":  "vite",
                    "pmem:open-session":  "node tools/pmem/pmem-runner.cjs open-session",
                    "pmem:compile-ext":  "node tools/pmem/pmem-runner.cjs compile-ext",
                    "tracker":  "node scripts/trackerAll.mjs",
                    "blackbox":  "node scripts/blackbox.mjs",
                    "prebuild":  "node scripts/prebuild.cjs",
                    "preview":  "vite preview",
                    "hooks:disable":  "git config --unset core.hooksPath",
                    "pmem:npm-run-ext":  "node tools/pmem/pmem-runner.cjs npm-run-ext",
                    "precommit:check":  "npm run blackbox \u0026\u0026 npm run contextpack"
                },
    "dependencies":  {
                         "html-to-image":  "^1.10.7",
                         "mammoth":  "^1.11.0",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "react-router-dom":  "^7.9.5"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.1",
                            "@types/node":  "^24.10.0",
                            "@types/react":  "^19.2.2",
                            "@types/react-dom":  "^19.2.2",
                            "@vitejs/plugin-react":  "^5.1.0",
                            "dependency-cruiser":  "^17.3.5",
                            "eslint":  "^9.39.1",
                            "eslint-plugin-react-hooks":  "^7.0.1",
                            "eslint-plugin-react-refresh":  "^0.4.24",
                            "globals":  "^16.5.0",
                            "madge":  "^8.0.0",
                            "typescript":  "~5.9.3",
                            "typescript-eslint":  "^8.46.3",
                            "vite":  "^7.2.2",
                            "yaml":  "^2.8.2"
                        }
}
